{
  "$schema": "./tokens.schema.json",
  "meta": {
    "project": "TShirtSwiss Elementor Free rebuild",
    "status": "initial-production-extraction",
    "source": "de/home/index.html production styles",
    "intentionalDifferences": [
      "Do not reproduce the thin red homepage announcement strip."
    ],
    "notes": [
      "Values in this file are the initial confirmed baseline from the production homepage.",
      "Responsive typography and spacing should be refined after screenshot comparison."
    ]
  },
  "colors": {
    "brandPrimary": "#e1111a",
    "brandSecondary": "#070707",
    "accent": "#e1111a",
    "textPrimary": "#111111",
    "textSecondary": "#555555",
    "surface": "#ffffff",
    "surfaceAlternate": "#f7f7f7",
    "border": "#e7e7e7",
    "success": "#1f8a4c",
    "warning": "#d68a00",
    "error": "#e1111a"
  },
  "typography": {
    "fontFamilies": {
      "heading": "Inter, Arial, Helvetica, sans-serif",
      "body": "Inter, Arial, Helvetica, sans-serif"
    },
    "fontWeights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extraBold": 800,
      "black": 900
    },
    "styles": {
      "display": { "desktop": 68, "tablet": 54, "mobile": 40, "lineHeight": 1.03, "weight": 900, "letterSpacing": -2.2 },
      "h1": { "desktop": 68, "tablet": 54, "mobile": 40, "lineHeight": 1.03, "weight": 900, "letterSpacing": -2.2 },
      "h2": { "desktop": 44, "tablet": 38, "mobile": 30, "lineHeight": 1.08, "weight": 900, "letterSpacing": -1.1 },
      "h3": { "desktop": 28, "tablet": 26, "mobile": 24, "lineHeight": 1.12, "weight": 800, "letterSpacing": -0.7 },
      "h4": { "desktop": 22, "tablet": 21, "mobile": 20, "lineHeight": 1.2, "weight": 800, "letterSpacing": -0.3 },
      "bodyLarge": { "desktop": 18, "tablet": 17, "mobile": 16, "lineHeight": 1.65, "weight": 400, "letterSpacing": 0 },
      "body": { "desktop": 16, "tablet": 16, "mobile": 15, "lineHeight": 1.65, "weight": 400, "letterSpacing": 0 },
      "bodySmall": { "desktop": 13, "tablet": 13, "mobile": 13, "lineHeight": 1.55, "weight": 400, "letterSpacing": 0 },
      "button": { "desktop": 12, "tablet": 12, "mobile": 12, "lineHeight": 1.2, "weight": 900, "letterSpacing": 0.02, "textTransform": "uppercase" },
      "caption": { "desktop": 11, "tablet": 11, "mobile": 11, "lineHeight": 1.45, "weight": 700, "letterSpacing": 0.05 }
    }
  },
  "layout": {
    "contentWidth": 1280,
    "wideWidth": 1440,
    "pageGutter": {
      "desktop": 32,
      "tablet": 28,
      "mobile": 20
    },
    "sectionSpacing": {
      "desktop": 74,
      "tablet": 60,
      "mobile": 48
    },
    "headerHeight": {
      "desktop": 108,
      "mobile": 84
    }
  },
  "spacing": {
    "xs": 8,
    "sm": 12,
    "md": 18,
    "lg": 24,
    "xl": 34,
    "2xl": 48,
    "3xl": 74
  },
  "radii": {
    "small": 4,
    "medium": 8,
    "large": 12,
    "pill": 999
  },
  "shadows": {
    "small": "0 12px 30px rgba(0,0,0,0.04)",
    "medium": "0 16px 40px rgba(0,0,0,0.06)",
    "large": "0 28px 80px rgba(0,0,0,0.38)",
    "header": "0 8px 30px rgba(0,0,0,0.08)",
    "button": "0 14px 26px rgba(225,17,26,0.26)"
  },
  "buttons": {
    "primary": {
      "text": "#ffffff",
      "background": "#e1111a",
      "border": "0 solid transparent",
      "radius": 4,
      "paddingVertical": 18,
      "paddingHorizontal": 26,
      "shadow": "0 14px 26px rgba(225,17,26,0.26)"
    },
    "secondary": {
      "text": "#111111",
      "background": "transparent",
      "border": "1px solid #111111",
      "radius": 4,
      "paddingVertical": 17,
      "paddingHorizontal": 25,
      "shadow": "none"
    },
    "inverseOutline": {
      "text": "#ffffff",
      "background": "transparent",
      "border": "1px solid rgba(255,255,255,0.75)",
      "radius": 4,
      "paddingVertical": 17,
      "paddingHorizontal": 25,
      "shadow": "none"
    },
    "text": {
      "text": "#e1111a",
      "background": "transparent",
      "border": "0 solid transparent",
      "radius": 0,
      "paddingVertical": 0,
      "paddingHorizontal": 0,
      "shadow": "none"
    }
  },
  "breakpoints": {
    "desktopReference": 1440,
    "tabletReference": 768,
    "mobileReference": 390,
    "elementorTabletMax": 1024,
    "elementorMobileMax": 767
  }
}
