                  "settings": {
                    "text": "{{PRIMARY_CTA_LABEL}}",
                    "link": {"url": "{{PRIMARY_CTA_URL}}"},
                    "button_type": "danger",
                    "size": "md",
                    "background_color": "#E31E24",
                    "button_text_color": "#FFFFFF",
                    "border_radius": {"unit": "px", "top": "4", "right": "4", "bottom": "4", "left": "4", "isLinked": true},
                    "css_classes": "tss-button tss-button--primary"
                  },
                  "elements": []
                },
                {
                  "id": "hero0008",
                  "elType": "widget",
                  "widgetType": "button",
                  "settings": {
                    "text": "{{SECONDARY_CTA_LABEL}}",
                    "link": {"url": "{{SECONDARY_CTA_URL}}"},
                    "size": "md",
                    "button_text_color": "#FFFFFF",
                    "background_color": "rgba(255,255,255,0)",
                    "border_border": "solid",
                    "border_width": {"unit": "px", "top": "1", "right": "1", "bottom": "1", "left": "1", "isLinked": true},
                    "border_color": "#FFFFFF",
                    "border_radius": {"unit": "px", "top": "4", "right": "4", "bottom": "4", "left": "4", "isLinked": true},
                    "css_classes": "tss-button tss-button--secondary"
                  },
                  "elements": []
                }
              ]
