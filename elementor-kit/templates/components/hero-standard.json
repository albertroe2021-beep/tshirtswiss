{
  "version": "0.4",
  "title": "TShirtSwiss - Hero Template",
  "type": "section",
  "page_settings": [],
  "content": [
    {
      "id": "hero0001",
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "boxed_width": {"unit": "px", "size": 1280},
        "min_height": {"unit": "px", "size": 620},
        "flex_direction": "column",
        "justify_content": "center",
        "padding": {"unit": "px", "top": "96", "right": "32", "bottom": "96", "left": "32", "isLinked": false},
        "background_background": "classic",
        "background_color": "#111111",
        "background_image": {"url": "{{HERO_BACKGROUND_IMAGE}}", "id": ""},
        "background_position": "center center",
        "background_size": "cover",
        "background_overlay_background": "classic",
        "background_overlay_color": "rgba(0,0,0,0.55)",
        "overflow": "hidden",
        "css_classes": "tss-hero tss-hero--standard"
      },
      "elements": [
        {
          "id": "hero0002",
          "elType": "container",
          "isInner": true,
          "settings": {
            "content_width": "full",
