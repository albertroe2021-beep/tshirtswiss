{
  "version": "0.4",
  "title": "TShirtSwiss - Global Header EN",
  "type": "section",
  "page_settings": [],
  "content": [
    {
      "id": "tsshead1",
      "elType": "container",
      "settings": {
        "content_width": "full",
        "background_background": "classic",
        "background_color": "#ffffff",
        "box_shadow_box_shadow": {
          "horizontal": 0,
          "vertical": 8,
          "blur": 30,
          "spread": 0,
          "color": "rgba(0,0,0,0.08)"
        },
        "z_index": 90
      },
      "elements": [
        {
          "id": "headhtml",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<style>\n.tss-header{font-family:Inter,Arial,Helvetica,sans-serif;background:#fff;color:#111;position:relative;z-index:90}.tss-topbar{background:#070707;color:#fff;font-size:12px}.tss-wrap{width:min(1280px,calc(100% - 64px));margin:0 auto}.tss-topbar .tss-wrap{min-height:48px;display:flex;align-items:center;justify-content:space-between;gap:24px}.tss-top-items{display:flex;align-items:center;gap:30px;flex-wrap:wrap}.tss-top-item{font-weight:800;letter-spacing:.02em;text-transform:uppercase}.tss-langs{display:flex;gap:10px;font-weight:900}.tss-main{background:#fff}.tss-main .tss-wrap{min-height:108px;display:flex;align-items:center;justify-content:space-between;gap:28px}.tss-logo{font-weight:900;font-size:34px;letter-spacing:-1.2px;line-height:.9;text-decoration:none;color:#111;white-space:nowrap}.tss-logo span{color:#e1111a}.tss-logo small{display:block;margin-top:10px;font-size:9px;letter-spacing:.12em;text-transform:uppercase;font-weight:700}.tss-nav{display:flex;align-items:center;gap:24px;font-size:12px;font-weight:800;text-transform:uppercase}.tss-nav a{color:#111;text-decoration:none;padding:44px 0}.tss-nav a:hover{color:#e1111a}.tss-quote{display:inline-flex;align-items:center;justify-content:center;background:#e1111a;color:#fff!important;padding:18px 26px!important;border-radius:4px;box-shadow:0 14px 26px rgba(225,17,26,.26)}.tss-toggle{display:none;border:0;background:#111;color:#fff;border-radius:4px;padding:13px 15px;font-weight:900;text-transform:uppercase}.tss-mobile{display:none;background:#fff;border-top:1px solid #e7e7e7}.tss-mobile a{display:block;padding:16px 20px;border-bottom:1px solid #e7e7e7;color:#111;text-decoration:none;font-weight:800;text-transform:uppercase;font-size:13px}.tss-mobile.is-open{display:block}@media(max-width:1024px){.tss-wrap{width:min(100% - 40px,1280px)}.tss-topbar{display:none}.tss-main .tss-wrap{min-height:84px}.tss-nav{display:none}.tss-toggle{display:inline-flex}.tss-logo{font-size:28px}}\n</style>\n<header class=\"tss-header\">\n  <div class=\"tss-topbar\"><div class=\"tss-wrap\"><div class=\"tss-top-items\"><span class=\"tss-top-item\">Swiss-managed production</span><span class=\"tss-top-item\">Quality-controlled apparel</span><span class=\"tss-top-item\">International delivery</span></div><div class=\"tss-langs\"><a href=\"/pages/\" style=\"color:#fff\">EN</a><a href=\"/de/home/\" style=\"color:#fff\">DE</a><a href=\"/fr/home/\" style=\"color:#fff\">FR</a></div></div></div>\n  <div class=\"tss-main\"><div class=\"tss-wrap\"><a class=\"tss-logo\" href=\"/pages/\">TShirt<span>Swiss</span><small>Custom clothing production</small></a><nav class=\"tss-nav\"><a href=\"/pages/products/\">Products</a><a href=\"/pages/services/\">Services</a><a href=\"/pages/industries/\">Industries</a><a href=\"/pages/resources/\">Resources</a><a href=\"/pages/about/\">About</a><a href=\"/pages/contact/\">Contact</a><a class=\"tss-quote\" href=\"/pages/contact/\">Request a quote</a></nav><button class=\"tss-toggle\" type=\"button\" aria-expanded=\"false\" aria-controls=\"tss-mobile-menu\">Menu</button></div></div>\n  <nav id=\"tss-mobile-menu\" class=\"tss-mobile\"><a href=\"/pages/products/\">Products</a><a href=\"/pages/services/\">Services</a><a href=\"/pages/industries/\">Industries</a><a href=\"/pages/resources/\">Resources</a><a href=\"/pages/about/\">About</a><a href=\"/pages/contact/\">Contact</a><a href=\"/pages/contact/\" style=\"color:#e1111a\">Request a quote</a></nav>\n</header>\n<script>(function(){const b=document.querySelector('.tss-toggle');const m=document.getElementById('tss-mobile-menu');if(!b||!m)return;b.addEventListener('click',()=>{const open=m.classList.toggle('is-open');b.setAttribute('aria-expanded',String(open));});})();</script>"
          },
          "elements": []
        }
      ]
    }
  ]
}
