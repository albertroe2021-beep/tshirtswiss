        {"id": "abtheading", "elType": "widget", "widgetType": "heading", "settings": {"title": "Swiss-managed apparel production with global capability", "header_size": "h1", "align": "center", "title_color": "#ffffff", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_size": {"unit": "px", "size": 56, "sizes": []}, "typography_font_size_mobile": {"unit": "px", "size": 38, "sizes": []}, "typography_font_weight": "900", "typography_line_height": {"unit": "em", "size": 1.05, "sizes": []}}, "elements": []},
        {"id": "abtintro", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>We help Swiss companies, brands, clubs and organisations turn apparel ideas into dependable production programmes, with clear local communication from concept through delivery.</p>", "align": "center", "text_color": "#f2f2f2", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_size": {"unit": "px", "size": 18, "sizes": []}, "typography_line_height": {"unit": "em", "size": 1.65, "sizes": []}}, "elements": []}
