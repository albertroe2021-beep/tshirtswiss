{
  "version": "0.4",
  "title": "TShirtSwiss - Industry Child Page Template",
  "type": "page",
  "page_settings": {
    "hide_title": "yes",
    "template": "elementor_canvas"
  },
  "content": [
    {
      "id": "indchild01",
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "full",
        "flex_direction": "column",
        "css_classes": "tss-page tss-industry-child-page"
      },
      "elements": [
        {
          "id": "indchildhero",
          "elType": "container",
          "isInner": true,
          "settings": {
            "content_width": "boxed",
            "boxed_width": {"unit": "px", "size": 1280},
            "min_height": {"unit": "px", "size": 560},
            "flex_direction": "column",
            "justify_content": "center",
            "padding": {"unit": "px", "top": "88", "right": "32", "bottom": "88", "left": "32", "isLinked": false},
            "background_background": "classic",
            "background_color": "#111111",
            "background_image": {"url": "{{INDUSTRY_HERO_IMAGE}}", "id": ""},
            "background_position": "center center",
            "background_size": "cover",
            "background_overlay_background": "classic",
            "background_overlay_color": "rgba(0,0,0,0.58)",
            "css_classes": "tss-industry-child__hero"
          },
          "elements": [
            {
              "id": "indchildbread",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {"editor": "<p>{{BREADCRUMBS}}</p>", "text_color": "#FFFFFF"},
              "elements": []
            },
            {
              "id": "indchildtitle",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {"title": "{{INDUSTRY_TITLE}}", "header_size": "h1", "title_color": "#FFFFFF"},
              "elements": []
