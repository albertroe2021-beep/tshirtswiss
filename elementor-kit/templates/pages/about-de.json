        {"id": "abtintrode", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Wir unterstützen Schweizer Unternehmen, Marken, Vereine und Organisationen dabei, Bekleidungsideen in zuverlässig geführte Produktionsprogramme umzusetzen – mit klarer lokaler Kommunikation vom Konzept bis zur Lieferung.</p>", "align": "center", "text_color": "#f2f2f2"}, "elements": []}
