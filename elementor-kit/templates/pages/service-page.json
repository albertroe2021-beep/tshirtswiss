          "elements": [
            {"id": "svcctatl", "elType": "widget", "widgetType": "heading", "settings": {"title": "{{SERVICE_CTA_TITLE}}", "header_size": "h2", "title_color": "#FFFFFF"}, "elements": []},
            {"id": "svcctabt", "elType": "widget", "widgetType": "button", "settings": {"text": "{{SERVICE_CTA_TEXT}}", "link": {"url": "{{SERVICE_CTA_URL}}"}, "background_color": "#FFFFFF", "button_text_color": "#111111"}, "elements": []}
          ]
        }
      ]
