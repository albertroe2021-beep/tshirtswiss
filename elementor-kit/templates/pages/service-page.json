                {"id": "svccard2", "elType": "container", "isInner": true, "settings": {"width": {"unit": "%", "size": 31.5}, "flex_direction": "column", "gap": {"unit": "px", "size": 12}, "padding": {"unit": "px", "top": "28", "right": "28", "bottom": "28", "left": "28", "isLinked": true}, "background_background": "classic", "background_color": "#F7F7F7"}, "elements": [{"id": "svcc2ttl", "elType": "widget", "widgetType": "heading", "settings": {"title": "{{SERVICE_2_TITLE}}", "header_size": "h3"}, "elements": []}, {"id": "svcc2txt", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>{{SERVICE_2_TEXT}}</p>"}, "elements": []}, {"id": "svcc2btn", "elType": "widget", "widgetType": "button", "settings": {"text": "{{SERVICE_2_CTA}}", "link": {"url": "{{SERVICE_2_URL}}"}}, "elements": []}]},
                {"id": "svccard3", "elType": "container", "isInner": true, "settings": {"width": {"unit": "%", "size": 31.5}, "flex_direction": "column", "gap": {"unit": "px", "size": 12}, "padding": {"unit": "px", "top": "28", "right": "28", "bottom": "28", "left": "28", "isLinked": true}, "background_background": "classic", "background_color": "#F7F7F7"}, "elements": [{"id": "svcc3ttl", "elType": "widget", "widgetType": "heading", "settings": {"title": "{{SERVICE_3_TITLE}}", "header_size": "h3"}, "elements": []}, {"id": "svcc3txt", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>{{SERVICE_3_TEXT}}</p>"}, "elements": []}, {"id": "svcc3btn", "elType": "widget", "widgetType": "button", "settings": {"text": "{{SERVICE_3_CTA}}", "link": {"url": "{{SERVICE_3_URL}}"}}, "elements": []}]}
              ]
            }
          ]
        },
        {
          "id": "svccta01",
          "elType": "container",
          "isInner": true,
          "settings": {
            "content_width": "boxed",
            "boxed_width": {"unit": "px", "size": 1280},
            "flex_direction": "row",
            "align_items": "center",
            "justify_content": "space-between",
            "gap": {"unit": "px", "size": 32},
            "padding": {"unit": "px", "top": "64", "right": "32", "bottom": "64", "left": "32", "isLinked": false},
            "background_background": "classic",
            "background_color": "#E1111A",
            "css_classes": "tss-service-page__cta"
