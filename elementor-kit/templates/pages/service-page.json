            "css_classes": "tss-service-page__hero"
          },
          "elements": [
            {"id": "svcbread", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>{{BREADCRUMBS}}</p>", "text_color": "#FFFFFF"}, "elements": []},
            {"id": "svctitle", "elType": "widget", "widgetType": "heading", "settings": {"title": "{{SERVICE_PAGE_TITLE}}", "header_size": "h1", "title_color": "#FFFFFF"}, "elements": []},
            {"id": "svcintro", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>{{SERVICE_PAGE_INTRO}}</p>", "text_color": "#FFFFFF"}, "elements": []}
          ]
        },
